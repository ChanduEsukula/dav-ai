# Local development may omit DATABASE_URL to use documented in-memory/demo
# fallbacks. Deployed environments must set DATABASE_URL because audit events,
# source pulls, saved monitors, scheduler locks, and user/profile storage fail
# closed when durable persistence is missing or unavailable.
DATABASE_URL=postgresql+psycopg://username:password@host:5432/database

# Runtime environment. Use local/test values for development. In hosted
# deployments, set DAVAI_ENV=production. Render also sets RENDER=true, which
# DavAI treats as deployed mode.
DAVAI_ENV=local

# Comma-separated frontend origins allowed to call the backend API.
# Local development:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production example:
# ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Prototype/demo bearer-token auth. Local development can use the built-in demo
# secret, but deployed environments must configure an explicit secret. This is
# not production RBAC or tenancy.
AUTH_SECRET_KEY=

# Ask DAV AI assistant defaults. Keep disabled unless a backend-only provider
# key is configured in the deployment environment.
ASSISTANT_LLM_ENABLED=false
ASSISTANT_LLM_PROVIDER=openai
ASSISTANT_LLM_MODEL=
ASSISTANT_LLM_API_KEY=
ASSISTANT_MAX_CONTEXT_RESULTS=5
ASSISTANT_MAX_QUESTION_CHARS=500
ASSISTANT_MAX_OUTPUT_CHARS=1200
