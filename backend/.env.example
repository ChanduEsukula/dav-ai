DATABASE_URL=postgresql+psycopg://username:password@host:5432/database

# Comma-separated frontend origins allowed to call the backend API.
# Local development:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production example:
# ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Ask DAV AI assistant defaults. Keep disabled unless a backend-only provider
# key is configured in the deployment environment.
ASSISTANT_LLM_ENABLED=false
ASSISTANT_LLM_PROVIDER=openai
ASSISTANT_LLM_MODEL=
ASSISTANT_LLM_API_KEY=
ASSISTANT_MAX_CONTEXT_RESULTS=5
ASSISTANT_MAX_QUESTION_CHARS=500
ASSISTANT_MAX_OUTPUT_CHARS=1200
