# Read-only local explorer. Omit the DB override to use the existing frozen repo artifact.
DAVAI_ENV=local
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DAV_AI_PHARMA_RELEASE_DB=/absolute/path/to/pharma.sqlite
# Deployed environments must use production; pharmaceutical serving remains denied.
# DAVAI_ENV=production
# Offline ingestion/migrations only; never required by the read-only API:
# DATABASE_URL=postgresql://username:password@localhost:5432/offline_pharma

# Publication is denied in deployed modes. Do not change local mode to evade the guard.
# An operator approval process is documented in docs/hardening/ARTIFACT_OPERATIONS.md.

# Managed installations: use exactly one of ARTIFACT_ROOT or RELEASE_DB.
# DAV_AI_PHARMA_ARTIFACT_ROOT=/srv/davai-artifacts
# Managed stores and deployed modes require readiness at startup automatically.
# DAV_AI_PHARMA_REQUIRE_READY_AT_STARTUP=1
